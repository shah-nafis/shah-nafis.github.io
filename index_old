  mobileMenu.classList.toggle('open');
});
mobileMenu.querySelectorAll('a').forEach(a => {
  a.addEventListener('click', () => mobileMenu.classList.remove('open'));
});

/* ─── Nav scroll shadow + active link ──────────────── */
const navbar = document.getElementById('navbar');
const sections = document.querySelectorAll('section[id], footer[id]');
const navLinks = document.querySelectorAll('#navLinks a');

window.addEventListener('scroll', () => {
  navbar.classList.toggle('scrolled', window.scrollY > 10);

  let current = '';
  sections.forEach(sec => {
    if (window.scrollY >= sec.offsetTop - 100) current = sec.id;
  });
  navLinks.forEach(a => {
    a.classList.toggle('active', a.getAttribute('href') === '#' + current);
  });
}, { passive: true });

/* ─── Typing animation ──────────────────────────────── */
const words = ['AI Specialist', 'Operations Builder', 'Product Thinker', 'Data Analyst'];
let wi = 0, ci = 0, deleting = false;
const el = document.getElementById('typingText');

function type() {
  const word = words[wi];
  if (!deleting) {
    el.textContent = word.slice(0, ++ci);
    if (ci === word.length) { deleting = true; setTimeout(type, 1800); return; }
  } else {
    el.textContent = word.slice(0, --ci);
    if (ci === 0) { deleting = false; wi = (wi + 1) % words.length; }
  }
  setTimeout(type, deleting ? 60 : 90);
}
type();

/* ─── Scroll fade-in ────────────────────────────────── */
const faders = document.querySelectorAll('.fade-in');
const observer = new IntersectionObserver((entries) => {
  entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); observer.unobserve(e.target); } });
}, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
faders.forEach(f => observer.observe(f));
/* ─── Availability & Tweaks (runs after DOM) ─────────── */
document.addEventListener('DOMContentLoaded', function() {

const AVAIL_KEY  = 'nafis-available';
const AUTH_KEY   = 'nafis-tweaks-auth';
const PWD_HASH   = 'c52722adb8468014830be4d568774822e9b8f60d83d7f693d3f3b99bf43a37fb';

/* Hash helper */
async function sha256(str) {
  const buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(str));
  return Array.from(new Uint8Array(buf)).map(b => b.toString(16).padStart(2,'0')).join('');
}

/* Auth state — survives the session, not just the page */
function isAuthed() { return sessionStorage.getItem(AUTH_KEY) === '1'; }
function setAuthed() { sessionStorage.setItem(AUTH_KEY, '1'); }

/* Open/close tweaks panel (only if authed) */
function openTweaks() {
  if (isAuthed()) { document.getElementById('tweaksPanel').classList.add('open'); }
  else            { document.getElementById('authOverlay').classList.add('open'); document.getElementById('authInput').focus(); }
}
function closeTweaks() {
  document.getElementById('tweaksPanel').classList.remove('open');
  window.parent.postMessage({ type: '__edit_mode_dismissed' }, '*');
}

/* Auth modal logic */
async function tryAuth() {
  const val = document.getElementById('authInput').value;
  const hash = await sha256(val);
  if (hash === PWD_HASH) {
    setAuthed();
    document.getElementById('authOverlay').classList.remove('open');
    document.getElementById('authInput').value = '';
    document.getElementById('authError').textContent = '';
    openTweaks();
  } else {
    const inp = document.getElementById('authInput');
    document.getElementById('authError').textContent = 'Incorrect password.';
    inp.classList.add('shake');
    inp.value = '';
    setTimeout(() => inp.classList.remove('shake'), 400);
  }
}

document.getElementById('authSubmit').addEventListener('click', tryAuth);
document.getElementById('authInput').addEventListener('keydown', e => { if (e.key === 'Enter') tryAuth(); });
document.getElementById('authCancel').addEventListener('click', () => {
  document.getElementById('authOverlay').classList.remove('open');
  document.getElementById('authInput').value = '';
  document.getElementById('authError').textContent = '';
});

/* Tweaks panel protocol */
window.addEventListener('message', (e) => {
  if (e.data && e.data.type === '__activate_edit_mode')   openTweaks();
  if (e.data && e.data.type === '__deactivate_edit_mode') closeTweaks();
});
window.parent.postMessage({ type: '__edit_mode_available' }, '*');

document.getElementById('tweaksClose').addEventListener('click', closeTweaks);
let copyClicks = 0, copyTimer;
document.getElementById('locationPin').addEventListener('click', () => {
  copyClicks++;
  clearTimeout(copyTimer);
  if (copyClicks >= 3) {
    copyClicks = 0;
    openTweaks();
  } else {
    copyTimer = setTimeout(() => { copyClicks = 0; }, 600);
  }
});

function applyAvailability(available, customMsg) {
  const dot  = document.getElementById('availDot');
  const text = document.getElementById('availText');
  const badge = document.getElementById('availBadge');
  const footerTag = document.getElementById('footerTagline');

  if (available) {
    dot.classList.remove('unavailable');
    text.textContent = customMsg || 'Available for AI & Ops leadership';
    badge.style.color = '';
    if (footerTag) footerTag.textContent = "Let's build something intelligent.";
  } else {
    dot.classList.add('unavailable');
    text.textContent = customMsg || 'Not currently open to new opportunities';
    badge.style.color = '#ef4444';
    if (footerTag) footerTag.textContent = 'Not taking on new work right now.';
  }
}

(function() {
  const saved = JSON.parse(localStorage.getItem(AVAIL_KEY) || '{"available":true,"msg":""}');
  applyAvailability(saved.available, saved.msg);
})();

/* Availability buttons */
let _available = JSON.parse(localStorage.getItem(AVAIL_KEY) || '{"available":true,"msg":""}').available;
let _msg       = JSON.parse(localStorage.getItem(AVAIL_KEY) || '{"available":true,"msg":""}').msg;

function refreshBtns() {
  document.getElementById('btnYes').classList.toggle('active-yes', _available);
  document.getElementById('btnNo').classList.toggle('active-no', !_available);
  const preview = document.getElementById('availPreview');
  if (_available) {
    preview.innerHTML = '<strong>Hero:</strong> "Available for AI &amp; Ops leadership" 🟢<br><strong>Footer:</strong> "Let\'s build something intelligent."';
  } else {
    preview.innerHTML = '<strong>Hero:</strong> "Not currently open to new opportunities" 🔴<br><strong>Footer:</strong> "Not taking on new work right now."';
  }
}
refreshBtns();

document.getElementById('btnYes').addEventListener('click', () => { _available = true;  refreshBtns(); });
document.getElementById('btnNo').addEventListener('click',  () => { _available = false; refreshBtns(); });

document.getElementById('tweaksApply').addEventListener('click', () => {
  _msg = document.getElementById('customMsgInput').value.trim();
  applyAvailability(_available, _msg);
  localStorage.setItem(AVAIL_KEY, JSON.stringify({ available: _available, msg: _msg }));
  window.parent.postMessage({ type: '__edit_mode_set_keys', edits: { available: _available, customMsg: _msg } }, '*');
  // Flash apply button
  const btn = document.getElementById('tweaksApply');
  btn.textContent = '✓ Applied!';
  setTimeout(() => { btn.textContent = 'Apply Changes'; }, 1800);
});

}); // end DOMContentLoaded
</script>

