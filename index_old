<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Shah Nafis Ahammed — AI Specialist & Operations Builder</title>
<meta name="description" content="Builder-operator hybrid at the intersection of AI, SaaS, and business operations.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@600;700;800&display=swap" rel="stylesheet">
<style>
/* ─── Tokens ─────────────────────────────────────────── */
:root {
  --bg:        #FAFAFA;
  --bg-alt:    #F4F6FF;
  --surface:   #FFFFFF;
  --brand:     #4169E1;
  --brand-mid: #2F55D4;
  --brand-dim: #EEF2FF;
  --text:      #1A1A2E;
  --text-2:    #4A4A6A;
  --text-3:    #8888A8;
  --border:    #E4E6F0;
  --radius:    10px;
  --shadow:    0 2px 12px rgba(65,105,225,.10);
  --shadow-md: 0 6px 28px rgba(65,105,225,.14);
  --nav-h:     64px;
  --transition: .22s cubic-bezier(.4,0,.2,1);
}
[data-theme="dark"] {
  --bg:        #0D1117;
  --bg-alt:    #141922;
  --surface:   #1A2030;
  --brand:     #6389F5;
  --brand-mid: #5177E8;
  --brand-dim: #1B2340;
  --text:      #E8EAF6;
  --text-2:    #9AA0C0;
  --text-3:    #5A6080;
  --border:    #252D44;
  --shadow:    0 2px 12px rgba(0,0,0,.35);
  --shadow-md: 0 6px 28px rgba(0,0,0,.45);
}

/* ─── Reset ──────────────────────────────────────────── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; font-size: 16px; }
body {
  font-family: 'Inter', system-ui, sans-serif;
  background: var(--bg);
  color: var(--text);
  line-height: 1.65;
  transition: background var(--transition), color var(--transition);
  text-wrap: pretty;
}
a { color: inherit; text-decoration: none; }
img { display: block; max-width: 100%; }
ul { list-style: none; }

/* ─── Typography ─────────────────────────────────────── */
h1,h2,h3,h4 { font-family: 'Poppins', sans-serif; line-height: 1.2; }
h1 { font-size: clamp(2.2rem, 5vw, 3.6rem); font-weight: 800; }
h2 { font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 700; }
h3 { font-size: 1.1rem; font-weight: 600; }

/* ─── Layout helpers ─────────────────────────────────── */
.container { max-width: 960px; margin: 0 auto; padding: 0 24px; }
.section    { padding: 80px 0; }
.section--alt { background: var(--bg-alt); }

/* ─── Section heading ────────────────────────────────── */
.section-title {
  font-family: 'Poppins', sans-serif;
  font-size: 1.75rem;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 8px;
}
.section-title span { color: var(--brand); }
.section-rule {
  width: 40px; height: 4px;
  background: var(--brand);
  border-radius: 4px;
  margin-bottom: 40px;
}

/* ─── Availability badge ────────────────────────────── */
.avail-badge {
  display: inline-flex; align-items: center; gap: 6px;
  font-size: .8rem; font-weight: 600; letter-spacing: 1.5px;
  color: var(--brand); text-transform: uppercase;
  margin-bottom: 12px;
}
.avail-dot {
  width: 8px; height: 8px; border-radius: 50%;
  background: #22c55e;
  animation: pulse-green 2s ease-in-out infinite;
  flex-shrink: 0;
}
.avail-dot.unavailable { background: #ef4444; animation: none; }
@keyframes pulse-green {
  0%,100%{ box-shadow: 0 0 0 0 rgba(34,197,94,.5); }
  50%{ box-shadow: 0 0 0 5px rgba(34,197,94,0); }
}

/* ─── Fade-in on scroll ──────────────────────────────── */
.fade-in { opacity: 0; transform: translateY(24px); transition: opacity .55s ease, transform .55s ease; }
.fade-in.visible { opacity: 1; transform: none; }

/* ─────────────────────────────────────────────────────── */
/* NAV */
/* ─────────────────────────────────────────────────────── */
nav {
  position: fixed; top: 0; left: 0; right: 0; z-index: 100;
  height: var(--nav-h);
  background: var(--surface);
  border-bottom: 1px solid var(--border);
  display: flex; align-items: center;
  transition: background var(--transition), box-shadow var(--transition);
}
nav.scrolled { box-shadow: var(--shadow); }
.nav-inner {
  max-width: 960px; margin: 0 auto; padding: 0 24px;
  display: flex; align-items: center; width: 100%;
}
.nav-logo {
  font-family: 'Poppins', sans-serif;
  font-weight: 800; font-size: 1.25rem;
  color: var(--brand);
  margin-right: auto;
  letter-spacing: -0.5px;
}
.nav-links {
  display: flex; align-items: center;
  background: var(--bg-alt);
  border: 1.5px solid var(--border);
  border-radius: 999px;
  padding: 4px;
  gap: 2px;
}
.nav-links a {
  font-size: .82rem; font-weight: 500;
  color: var(--text-2);
  padding: 5px 14px;
  border-radius: 999px;
  transition: color var(--transition), background var(--transition);
  white-space: nowrap;
}
.nav-links a:hover { color: var(--brand); background: var(--surface); }
.nav-links a.active {
  color: var(--brand);
  background: var(--surface);
  box-shadow: 0 1px 4px rgba(65,105,225,.12);
}
.nav-dark-btn {
  margin-left: 12px;
  width: 36px; height: 36px;
  border-radius: 50%; border: 1.5px solid var(--border);
  background: var(--bg);
  cursor: pointer; display: flex; align-items: center; justify-content: center;
  font-size: 1rem;
  transition: background var(--transition), border-color var(--transition);
}
.nav-dark-btn:hover { background: var(--brand-dim); border-color: var(--brand); }
.nav-hamburger {
  display: none; flex-direction: column; gap: 5px; cursor: pointer; padding: 6px; margin-left: 8px;
}
.nav-hamburger span { width: 22px; height: 2px; background: var(--text); border-radius: 2px; transition: var(--transition); }
.mobile-menu {
  display: none; position: fixed; top: var(--nav-h); left: 0; right: 0;
  background: var(--surface); border-bottom: 1px solid var(--border);
  padding: 16px 24px; z-index: 99; flex-direction: column; gap: 4px;
}
.mobile-menu.open { display: flex; }
.mobile-menu a {
  padding: 10px 12px; border-radius: 8px;
  font-weight: 500; font-size: .95rem;
  color: var(--text-2);
  transition: background var(--transition), color var(--transition);
}
.mobile-menu a:hover { background: var(--brand-dim); color: var(--brand); }
@media (max-width: 700px) {
  .nav-links { display: none; }
  .nav-hamburger { display: flex; }
}

/* ─────────────────────────────────────────────────────── */
/* HERO */
/* ─────────────────────────────────────────────────────── */
#hero {
  min-height: 100vh;
  display: flex; align-items: center;
  padding-top: var(--nav-h);
  background: var(--surface);
}
.hero-inner {
  display: flex; align-items: center; gap: 56px;
  padding: 64px 0;
}
.hero-text { flex: 1; }
.hero-avatar {
  flex-shrink: 0;
  width: 200px; height: 200px;
  border-radius: 50%;
  background: var(--brand-dim);
  overflow: hidden;
  border: 5px solid var(--brand-dim);
  box-shadow: var(--shadow-md);
  position: relative;
}
.hero-avatar img {
  width: 100%; height: 100%;
  object-fit: cover; object-position: center top;
}
.hero-avatar::after {
  content: '';
  position: absolute; inset: -8px;
  border-radius: 50%;
  border: 2px dashed var(--brand);
  opacity: .3;
}
.hero-eyebrow {
  font-size: .8rem; font-weight: 600; letter-spacing: 2px;
  color: var(--brand); text-transform: uppercase;
  margin-bottom: 12px;
}
.hero-name { color: var(--text); margin-bottom: 8px; }
.hero-subtitle {
  font-size: 1.05rem; font-weight: 500;
  color: var(--text-2);
  margin-bottom: 4px;
}
.hero-typing {
  height: 2rem;
  font-family: 'Poppins', sans-serif;
  font-size: 1.1rem; font-weight: 600;
  color: var(--brand);
  margin-bottom: 20px;
  display: flex; align-items: center; gap: 4px;
}
.cursor {
  display: inline-block;
  width: 2px; height: 1.1em;
  background: var(--brand);
  animation: blink 1s step-end infinite;
  border-radius: 1px;
  flex-shrink: 0;
}
@keyframes blink { 0%,100%{opacity:1} 50%{opacity:0} }
.hero-bio {
  color: var(--text-2);
  font-size: .975rem;
  max-width: 460px;
  margin-bottom: 32px;
  line-height: 1.7;
}
.hero-ctas { display: flex; gap: 12px; flex-wrap: wrap; }
.btn {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 12px 24px; border-radius: var(--radius);
  font-weight: 600; font-size: .9rem;
  cursor: pointer; border: 2px solid transparent;
  transition: all var(--transition); white-space: nowrap;
}
.btn-primary {
  background: var(--brand); color: #fff;
  border-color: var(--brand);
}
.btn-primary:hover { background: var(--brand-mid); border-color: var(--brand-mid); transform: translateY(-1px); box-shadow: var(--shadow-md); }
.btn-outline {
  background: transparent; color: var(--brand);
  border-color: var(--brand);
}
.btn-outline:hover { background: var(--brand-dim); transform: translateY(-1px); }
@media (max-width: 700px) {
  .hero-inner { flex-direction: column-reverse; gap: 32px; padding: 48px 0 32px; }
  .hero-avatar { width: 120px; height: 120px; }
}

/* ─────────────────────────────────────────────────────── */
/* ABOUT */
/* ─────────────────────────────────────────────────────── */
.about-grid {
  display: grid; grid-template-columns: 1fr 1fr;
  gap: 48px; align-items: start;
}
.about-bio { color: var(--text-2); line-height: 1.8; }
.about-bio p { margin-bottom: 16px; }
.contact-strip {
  background: var(--surface);
  border: 1.5px solid var(--border);
  border-radius: var(--radius);
  padding: 24px;
  display: flex; flex-direction: column; gap: 14px;
  box-shadow: var(--shadow);
}
.contact-item {
  display: flex; align-items: center; gap: 12px;
  font-size: .9rem; color: var(--text-2);
}
.contact-icon {
  width: 36px; height: 36px;
  background: var(--brand-dim);
  border-radius: 8px;
  display: flex; align-items: center; justify-content: center;
  color: var(--brand); font-size: 1rem; flex-shrink: 0;
}
.contact-item a { color: var(--brand); font-weight: 500; }
.contact-item a:hover { text-decoration: underline; }
@media (max-width: 700px) {
  .about-grid { grid-template-columns: 1fr; gap: 32px; }
}

/* ─────────────────────────────────────────────────────── */
/* EXPERIENCE TIMELINE */
/* ─────────────────────────────────────────────────────── */
.timeline { position: relative; padding-left: 32px; }
.timeline::before {
  content: '';
  position: absolute; left: 8px; top: 8px; bottom: 8px;
  width: 2px; background: var(--border); border-radius: 2px;
}
.tl-item {
  position: relative; margin-bottom: 40px;
}
.tl-item:last-child { margin-bottom: 0; }
.tl-dot {
  position: absolute; left: -28px; top: 18px;
  width: 14px; height: 14px; border-radius: 50%;
  background: var(--surface);
  border: 3px solid var(--brand);
  box-shadow: 0 0 0 3px var(--brand-dim);
}
.tl-card {
  background: var(--surface);
  border: 1.5px solid var(--border);
  border-radius: var(--radius);
  padding: 24px;
  transition: box-shadow var(--transition), border-color var(--transition);
}
.tl-card:hover { box-shadow: var(--shadow-md); border-color: var(--brand); }
.tl-header {
  display: flex; flex-wrap: wrap; align-items: flex-start;
  justify-content: space-between; gap: 8px;
  margin-bottom: 6px;
}
.tl-role { font-family: 'Poppins', sans-serif; font-size: 1.05rem; font-weight: 700; color: var(--text); }
.tl-badge {
  font-size: .7rem; font-weight: 600;
  padding: 3px 10px; border-radius: 20px;
  background: var(--brand-dim); color: var(--brand);
  white-space: nowrap; align-self: flex-start;
  border: 1px solid var(--brand);
}
.tl-company {
  font-size: .9rem; font-weight: 600; color: var(--brand);
  margin-bottom: 3px;
}
.tl-meta {
  font-size: .8rem; color: var(--text-3); margin-bottom: 14px;
}
.tl-bullets { padding-left: 18px; }
.tl-bullets li {
  list-style: disc; font-size: .9rem;
  color: var(--text-2); margin-bottom: 6px; line-height: 1.6;
}
.tl-tech {
  margin-top: 12px;
  display: flex; flex-wrap: wrap; gap: 6px;
}
.tech-tag {
  font-size: .75rem; font-weight: 500;
  padding: 3px 10px; border-radius: 20px;
  background: var(--bg-alt); color: var(--text-3);
  border: 1px solid var(--border);
}

/* ─────────────────────────────────────────────────────── */
/* SKILLS */
/* ─────────────────────────────────────────────────────── */
.skills-grid {
  display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 20px;
}
.skill-card {
  background: var(--surface);
  border: 1.5px solid var(--border);
  border-radius: var(--radius);
  padding: 20px;
  transition: box-shadow var(--transition);
}
.skill-card:hover { box-shadow: var(--shadow-md); }
.skill-cat {
  font-family: 'Poppins', sans-serif;
  font-size: .85rem; font-weight: 700;
  color: var(--text); margin-bottom: 12px;
  display: flex; align-items: center; gap: 8px;
}
.skill-cat-icon {
  width: 28px; height: 28px; border-radius: 7px;
  background: var(--brand-dim);
  display: flex; align-items: center; justify-content: center;
  font-size: .9rem;
}
.skill-tags { display: flex; flex-wrap: wrap; gap: 6px; }
.skill-tag {
  font-size: .78rem; font-weight: 500;
  padding: 4px 10px; border-radius: 20px;
  background: var(--brand-dim); color: var(--brand);
  border: 1px solid rgba(65,105,225,.25);
  transition: background var(--transition), color var(--transition);
}
.skill-tag:hover { background: var(--brand); color: #fff; }

/* ─────────────────────────────────────────────────────── */
/* EDUCATION */
/* ─────────────────────────────────────────────────────── */
.edu-card {
  background: var(--surface);
  border: 1.5px solid var(--border);
  border-radius: var(--radius);
  padding: 32px;
  display: flex; gap: 28px; align-items: flex-start;
  box-shadow: var(--shadow);
}
.edu-badge {
  width: 56px; height: 56px;
  background: var(--brand); color: #fff;
  border-radius: 12px;
  display: flex; align-items: center; justify-content: center;
  font-family: 'Poppins', sans-serif; font-weight: 800; font-size: .8rem;
  text-align: center; line-height: 1.2; flex-shrink: 0;
}
.edu-degree {
  font-family: 'Poppins', sans-serif;
  font-size: 1.15rem; font-weight: 700; color: var(--text);
  margin-bottom: 4px;
}
.edu-uni { font-weight: 600; color: var(--brand); margin-bottom: 4px; }
.edu-meta { font-size: .85rem; color: var(--text-3); margin-bottom: 12px; }
.edu-honors {
  display: inline-flex; align-items: center; gap: 6px;
  background: var(--brand-dim); color: var(--brand);
  padding: 4px 12px; border-radius: 20px;
  font-size: .8rem; font-weight: 600;
  border: 1px solid var(--brand);
  margin-bottom: 12px;
}
.edu-courses {
  font-size: .85rem; color: var(--text-2);
  margin-bottom: 10px;
}
.edu-link {
  font-size: .85rem; color: var(--brand); font-weight: 600;
}
.edu-link:hover { text-decoration: underline; }
@media (max-width: 600px) {
  .edu-card { flex-direction: column; gap: 16px; }
}

/* ─────────────────────────────────────────────────────── */
/* CERTS & AWARDS */
/* ─────────────────────────────────────────────────────── */
.certs-grid {
  display: grid; grid-template-columns: 1fr 1fr;
  gap: 24px;
}
.certs-box {
  background: var(--surface);
  border: 1.5px solid var(--border);
  border-radius: var(--radius);
  padding: 24px;
}
.certs-box-title {
  font-family: 'Poppins', sans-serif;
  font-size: 1rem; font-weight: 700;
  color: var(--text); margin-bottom: 16px;
  padding-bottom: 12px;
  border-bottom: 2px solid var(--brand-dim);
}
.cert-item {
  display: flex; align-items: flex-start; gap: 10px;
  margin-bottom: 12px; font-size: .9rem; color: var(--text-2);
}
.cert-dot {
  width: 8px; height: 8px; border-radius: 50%;
  background: var(--brand); flex-shrink: 0; margin-top: 6px;
}
.cert-wip {
  font-size: .72rem; color: var(--text-3);
  background: var(--bg-alt); padding: 1px 7px;
  border-radius: 10px; margin-left: 4px;
  border: 1px solid var(--border);
}
.award-item {
  display: flex; align-items: center; gap: 10px;
  margin-bottom: 10px; font-size: .9rem; color: var(--text-2);
}
.award-icon { font-size: 1.1rem; }
@media (max-width: 600px) {
  .certs-grid { grid-template-columns: 1fr; }
}

/* ─────────────────────────────────────────────────────── */
/* LANGUAGES */
/* ─────────────────────────────────────────────────────── */
.lang-strip {
  display: flex; gap: 20px; flex-wrap: wrap;
}
.lang-card {
  background: var(--surface);
  border: 1.5px solid var(--border);
  border-radius: var(--radius);
  padding: 20px 28px;
  display: flex; align-items: center; gap: 14px;
  flex: 1 1 220px;
}
.lang-flag { font-size: 1.5rem; }
.lang-name { font-family: 'Poppins', sans-serif; font-weight: 700; font-size: 1rem; color: var(--text); }
.lang-level { font-size: .85rem; color: var(--text-3); }
.lang-badge {
  margin-left: auto;
  font-size: .78rem; font-weight: 600;
  padding: 4px 10px; border-radius: 20px;
  background: var(--brand-dim); color: var(--brand);
  border: 1px solid var(--brand);
}

/* ─────────────────────────────────────────────────────── */
/* FOOTER */
/* ─────────────────────────────────────────────────────── */
footer {
  background: var(--text);
  color: #fff;
  padding: 48px 0 32px;
}
[data-theme="dark"] footer { background: var(--surface); border-top: 1px solid var(--border); }
.footer-inner {
  max-width: 960px; margin: 0 auto; padding: 0 24px;
}
.footer-tagline {
  font-family: 'Poppins', sans-serif;
  font-size: 1.5rem; font-weight: 700;
  margin-bottom: 24px; color: #fff;
}
[data-theme="dark"] .footer-tagline { color: var(--text); }
.footer-links {
  display: flex; flex-wrap: wrap; gap: 16px;
  margin-bottom: 32px;
}
.footer-link {
  display: flex; align-items: center; gap: 8px;
  color: rgba(255,255,255,.7);
  font-size: .9rem; font-weight: 500;
  transition: color var(--transition);
}
[data-theme="dark"] .footer-link { color: var(--text-2); }
.footer-link:hover { color: #fff; }
[data-theme="dark"] .footer-link:hover { color: var(--brand); }
.footer-link span {
  width: 32px; height: 32px; border-radius: 8px;
  background: rgba(255,255,255,.1);
  display: flex; align-items: center; justify-content: center;
  font-size: 1rem;
}
.footer-copy {
  border-top: 1px solid rgba(255,255,255,.12);
  padding-top: 24px;
  font-size: .82rem; color: rgba(255,255,255,.45);
}
[data-theme="dark"] .footer-copy { border-color: var(--border); color: var(--text-3); }
/* ─── Auth modal ─────────────────────────────────────── */
.auth-overlay {
  display: none; position: fixed; inset: 0; z-index: 10000;
  background: rgba(0,0,0,.55); backdrop-filter: blur(4px);
  align-items: center; justify-content: center;
}
.auth-overlay.open { display: flex; }
.auth-box {
  background: var(--surface); border-radius: 16px;
  border: 1.5px solid var(--border);
  box-shadow: 0 20px 60px rgba(0,0,0,.3);
  padding: 32px 28px; width: 320px; text-align: center;
}
.auth-icon { font-size: 2rem; margin-bottom: 12px; }
.auth-title {
  font-family: 'Poppins', sans-serif; font-weight: 700;
  font-size: 1.1rem; color: var(--text); margin-bottom: 6px;
}
.auth-sub { font-size: .85rem; color: var(--text-3); margin-bottom: 20px; }
.auth-input {
  width: 100%; padding: 10px 14px;
  border: 1.5px solid var(--border); border-radius: 10px;
  background: var(--bg); color: var(--text);
  font-family: 'Inter', sans-serif; font-size: 1rem;
  text-align: center; letter-spacing: 4px;
  outline: none; margin-bottom: 12px;
  transition: border-color .2s;
}
.auth-input:focus { border-color: var(--brand); }
.auth-input.shake {
  animation: shake .35s cubic-bezier(.36,.07,.19,.97);
  border-color: #ef4444;
}
@keyframes shake {
  0%,100%{transform:translateX(0)} 20%{transform:translateX(-8px)} 40%{transform:translateX(8px)} 60%{transform:translateX(-5px)} 80%{transform:translateX(5px)}
}
.auth-btn {
  width: 100%; padding: 11px;
  background: var(--brand); color: #fff; border: none;
  border-radius: 10px; font-family: 'Poppins', sans-serif;
  font-weight: 700; font-size: .95rem; cursor: pointer;
  transition: background .2s; margin-bottom: 10px;
}
.auth-btn:hover { background: var(--brand-mid); }
.auth-cancel {
  font-size: .82rem; color: var(--text-3); cursor: pointer;
  background: none; border: none; font-family: 'Inter', sans-serif;
}
.auth-cancel:hover { color: var(--text); }
.auth-error { font-size: .8rem; color: #ef4444; margin-bottom: 8px; min-height: 18px; }
#tweaksPanel {
  display: none;
  position: fixed; bottom: 24px; right: 24px; z-index: 9999;
  background: var(--surface);
  border: 1.5px solid var(--border);
  border-radius: 16px;
